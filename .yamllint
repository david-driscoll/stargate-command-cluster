# yamllint config for the hk `yamllint` step (see hk.pkl).
#
# Intent: catch YAML that Flux/Talos would mis-apply, NOT enforce a house style
# on ~810 existing manifests. Every rule disabled below was measured against the
# current tree first: `extends: default` reports 2009 findings in kubernetes/
# alone (1391 of them `line-length`), which is a style disagreement with the
# upstream home-operations manifest conventions this repo was seeded from --
# not a set of bugs.
#
# The rules that are KEPT are the ones with real blast radius:
#   * YAML syntax errors            - the file never parses
#   * key-duplicates                - a repeated key in a HelmRelease silently
#                                     drops the earlier value; no error is
#                                     surfaced anywhere in the Flux pipeline
#   * octal-values                  - `mode: 0644` parsing as decimal 644
#   * empty-values                  - a key with no value becomes null
#   * trailing-spaces / newline-at-eof - overlap with the hk builtins, kept so
#                                     `yamllint` is self-consistent standalone
#
# Cosmetic rules stay off. If the repo ever adopts a YAML formatter, revisit.

extends: default

rules:
  line-length: disable
  document-start: disable
  braces: disable
  brackets: disable
  indentation: disable
  comments: disable
  comments-indentation: disable
  empty-lines: disable
  colons: disable
  # `on:` in GitHub Actions workflows is a legitimate key that yamllint's
  # truthy rule flags; the value-side check is the useful half.
  truthy:
    check-keys: false
